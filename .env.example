POSTGRES_DB=qualifier
POSTGRES_USER=qualifier
# Set your own database password before starting Compose.
POSTGRES_PASSWORD=
# Required only when running Python directly, outside Compose.
DATABASE_URL=
# For local HTTP development only, change to false.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_HOURS=12
AUTH_INVITE_HOURS=24
# Public HTTPS origin used for invitation links, without a trailing path.
# Empty uses the origin from the request; frontend and API must share an origin.
AUTH_PUBLIC_ORIGIN=

# rules works without a model, credentials, or external requests.
EXTRACTOR=rules
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Set an available model supporting strict JSON Schema before choosing EXTRACTOR=llm.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# Incoming webhook URL with CRM access. Required to read and update leads.
BITRIX_WEBHOOK_URL=
BITRIX_TEXT_FIELD=comments
BITRIX_TIMEOUT_SECONDS=15
# Background polling worker runs with the API. Enabling polling and choosing
# a recipient are done by an administrator in the Auto-processing section.
MONITOR_WORKER_ENABLED=true
# Map qualification attributes to the actual custom fields of your portal.
BITRIX_FIELD_MAP={}
PRIORITY_BUDGET_THRESHOLD_RUB=100000
